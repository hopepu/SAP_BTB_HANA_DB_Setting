<mvc:View
    controllerName="ui5.walkthrough.controller.InvoiceList"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc">
        
    <VBox>       
        <HBox justifyContent="Center">
            <!-- 요청 번호 필터 -->            
            <Input id="requestNumberFilter" liveChange="onFilterChange" placeholder="신청 번호"/>
            <!-- 요청 물품 필터 -->            
            <Input id="requestProductFilter" liveChange="onFilterChange" placeholder="상품명"/>
            <!-- 요청자 필터 -->            
            <Input id="requestorFilter" liveChange="onFilterChange" placeholder="요청자"/>
            <!-- 요청 일자 필터 -->            
            <DatePicker id="requestDateFilter" liveChange="onFilterChange" placeholder="신청 날짜"/>
            <!-- 처리 상태 필터 -->            
            <Select id="requestStateFilter" change="onFilterChange">
                <items>
                    <core:Item key="" text="진행도" />
                    <core:Item key="A" text="반려" />
                    <core:Item key="B" text="신청 중" />
                    <core:Item key="C" text="구매 진행중" />
                    <core:Item key="D" text="구매 완료" />
                </items>
            </Select>
            <Button text="초기화" press=".onResetFilter" type="Emphasized"/>
            <Button text="검색" press=".onSearchFilter" type="Accept"/>
        </HBox>
    </VBox>

    <!-- 요청 데이터 테이블 -->
    <Table
        id="RequestLists"
        class="sapUiResponsiveMargin"        
        width="auto"
        items="{
            path: 'request>/Request',
            sorter: {
                path: 'request_date',
                group: false   

            }
        }">       
        <columns>            
            <Column hAlign="Center">
                <Text text="{i18n>columnRequestNumber}"/>
            </Column>
            <Column hAlign="Center">
                <Text text="{i18n>columnRequestProduct}"/>
            </Column>
            <Column hAlign="Center">
                <Text text="{i18n>columnRequestQuantity}"/>
            </Column>
            <Column hAlign="Center">
                <Text text="{i18n>columnRequestor}"/>
            </Column>
            <Column hAlign="Center">
                <Text text="{i18n>columnRequestDate}"/>
            </Column>
            <Column hAlign="Center">
                <Text text="{i18n>columnRequestState}"/>
            </Column>
        </columns>
        <items>
            <ColumnListItem
                type="Navigation"
                press=".onPress">
                <cells>                    
                    <Text text="{request>request_number}"/>
                    <Text text="{request>request_product}"/>
                    <Text text="{request>request_quantity}"/>
                    <Text text="{request>requestor}"/>
                    <Text text="{request>request_date}"/>
                    <Text text="{ path: 'request>request_state', formatter: '.formatter.statusText' }" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>
